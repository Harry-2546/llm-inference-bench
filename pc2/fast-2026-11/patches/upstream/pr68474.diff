+def _phase(**overrides):
+    phase = {
+        "decode": "unquantized",
+        "prefill": "nvfp4",
+        "max_decode_tokens": MAX_DECODE_TOKENS,
+        **overrides,
+    }
+    return quant_spec(phase=phase).phase
+
